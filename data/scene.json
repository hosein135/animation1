{
  "title": "Pelican Coastal Parade - Bicycle Ride",
  "builder": "declarative",
  "seed": 14,
  "fps": 14,
  "duration_seconds": 4,
  "resolution": [1920, 1080],
  "background_color": [0.39, 0.60, 0.74, 1.0],
  "background_strength": 0.24,
  "camera": {
    "name": "ParadeCamera",
    "location": [5.6, -21.0, 6.3],
    "look_at": [0.0, 0.6, 2.7],
    "lens": 50,
    "ortho_scale": 9.4,
    "type": "ORTHO"
  },
  "params": {
    "x_start": -3.2,
    "x_end": 3.8,
    "wheel_radius": 0.91
  },
  "objects": [
    {
      "ref": "ride_root",
      "name": "RideRoot",
      "children": [
        { "ref": "bicycle", "name": "Bicycle" },
        { "ref": "pelican", "name": "Pelican" }
      ]
    },
    { "ref": "boardwalk", "name": "Boardwalk" },
    { "ref": "environment", "name": "Environment" }
  ],
  "lights": [
    {
      "type": "light",
      "name": "Warm setting sun",
      "location": [-5, -3, 8],
      "energy": 850,
      "size": 4,
      "color": [1, 0.77, 0.53],
      "aim_at": [0, 0, 2.3]
    },
    {
      "type": "light",
      "name": "Cool sky fill",
      "location": [4, -5, 7],
      "energy": 450,
      "size": 5,
      "color": [0.65, 0.84, 1],
      "aim_at": [0, 0, 2.3]
    },
    {
      "type": "light",
      "name": "Golden rim",
      "location": [-2, 6, 6],
      "energy": 1000,
      "size": 3,
      "color": [1, 0.59, 0.29],
      "aim_at": [0, 0, 2.3]
    }
  ],
  "actions": [
    {
      "action": "translate",
      "target": "RideRoot",
      "from": [-3.2, 0, 0],
      "to": [3.8, 0, 0]
    },
    {
      "action": "spin",
      "target": "RearWheel",
      "distance": 7.0,
      "radius": 0.91,
      "axis": 1,
      "invert": true
    },
    {
      "action": "spin",
      "target": "FrontWheel",
      "distance": 7.0,
      "radius": 0.91,
      "axis": 1,
      "invert": true
    },
    {
      "action": "bob",
      "target": "Plump pelican body",
      "axis": 2,
      "amplitude": 0.045,
      "cycles": 6.0
    },
    {
      "action": "flutter",
      "target": "Scarf flutter",
      "axis": 2,
      "amplitude": 0.18,
      "cycles": 8.0
    },
    {
      "action": "bob_matching",
      "prefix": "Party balloon",
      "axis": 2,
      "amplitude": 0.08,
      "cycles": 5.0,
      "steps": 5
    },
    {
      "action": "follow_axis",
      "target": "ParadeCamera",
      "axis": 0,
      "base": [5.6, -21.0, 6.3],
      "values": [-1.12, 1.33]
    },
    {
      "action": "look_at",
      "target": "ParadeCamera",
      "locations": [
        [4.48, -21.0, 6.3],
        [6.93, -21.0, 6.3]
      ],
      "points": [
        [-3.2, 0.6, 2.7],
        [3.8, 0.6, 2.7]
      ]
    },
    {
      "action": "set_interpolation",
      "targets": ["RideRoot", "RearWheel", "FrontWheel", "ParadeCamera"],
      "mode": "LINEAR"
    }
  ],
  "acceleration": {
    "renderer": "blender",
    "blender_engine": "eevee",
    "blender_workers": 0,
    "blender_threads": 0,
    "prefer_cycles_gpu": true,
    "eevee_samples": 8,
    "cycles_samples": 28,
    "cycles_adaptive": true,
    "cycles_noise_threshold": 0.05,
    "cycles_min_samples": 4,
    "cycles_denoise": true,
    "cycles_tile_size": 512
  },
  "output": {
    "frame_format": "JPEG",
    "jpeg_quality": 90,
    "png_compression": 1,
    "video_codec": "auto",
    "prefer_encoder": "auto",
    "video_crf": 18,
    "video_cq": 19,
    "video_preset": "fast",
    "nvenc_preset": "p4"
  }
}
