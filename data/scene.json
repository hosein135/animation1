{
  "title": "Monthly Pulse",
  "fps": 24,
  "duration_seconds": 4,
  "resolution": [1280, 720],
  "background_color": [0.06, 0.08, 0.12, 1.0],
  "camera": {
    "location": [0.0, -12.0, 6.0],
    "look_at": [0.0, 0.0, 1.2],
